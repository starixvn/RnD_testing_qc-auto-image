    "scripts": {
        "CI_SelGame_Smoke": "mocha --timeout 0 Games/$npm_config_game/*_Test.js -r @babel/register --file ./Setup.js  --fgrep Smoke_ --file ./Teardown.js  --reporter mochawesome --reporter-options reportDir=Report/$npm_config_cf_lang --retries 1",
        "CI_SelGame_Full": "mocha --timeout 0 Games/$npm_config_game/*_Test.js -r @babel/register --file ./Setup.js  --fgrep Full_ --file ./Teardown.js  --reporter mochawesome --reporter-options reportDir=Report/$npm_config_cf_lang ",
        "Win_SelGame_Smoke": "mocha --timeout 0 Games/%npm_config_game%/*_Test.js -r @babel/register --fgrep Smoke_ --file ./Setup.js --file ./Teardown.js  --reporter mochawesome --reporter-options reportDir=Report/%npm_config_cf_lang% --retries 1",
        "sendResultToTelegram": "mocha --timeout 0 util/SendResultToTelegram/*.js -r @babel/register",
        "mobile": "mocha --timeout 0  Devices/*_Test.js -r @babel/register  --fgrep Smoke_  --file  Devices/mobile_Setup.js --file Devices/mobile_TearDown.js  --reporter mochawesome --reporter-options reportDir=Report/Mobile"
    }
